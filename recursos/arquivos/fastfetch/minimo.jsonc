// minimalista, do d3bian-init-terminal: sem logo, so o essencial, alinhado
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  ",
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    "break",
    { "type": "os", "key": "sistema", "keyColor": "90", "format": "{pretty-name}" },
    { "type": "kernel", "key": "kernel", "keyColor": "90", "format": "{release}" },
    { "type": "shell", "key": "shell", "keyColor": "90", "format": "{pretty-name}" },
    { "type": "memory", "key": "memoria", "keyColor": "90" },
    { "type": "uptime", "key": "ligado", "keyColor": "90" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 },
    "break"
  ]
}
